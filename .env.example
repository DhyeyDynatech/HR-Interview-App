# =============================================================
#  HR Interviewer — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# =============================================================


# -------------------------------------------------------------
#  App
# -------------------------------------------------------------
NEXT_PUBLIC_LIVE_URL=localhost:3000          # Base URL (no https://) — set to your domain in production


# -------------------------------------------------------------
#  Supabase  (https://supabase.com/dashboard/project/<id>/settings/api)
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # Server-only — never expose to browser


# -------------------------------------------------------------
#  Retell AI  (https://app.retellai.com/apikey)
# -------------------------------------------------------------
RETELL_API_KEY=<your-retell-api-key>


# -------------------------------------------------------------
#  OpenAI  (https://platform.openai.com/api-keys)
# -------------------------------------------------------------
OPENAI_API_KEY=<your-openai-api-key>


# -------------------------------------------------------------
#  Azure OpenAI  (https://portal.azure.com → Azure OpenAI → Keys)
# -------------------------------------------------------------
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT5_MINI=<your-deployment-name>   # Deployment name from Azure AI Foundry
# Optional: hard timeout (ms) for the interview-analytics OpenAI call. If a
# scoring request stalls past this, it's aborted so callers don't hang. Default 120000 (2 min).
OPENAI_ANALYTICS_TIMEOUT_MS=120000


# -------------------------------------------------------------
#  Email — Power Automate Flow
#  (Power Automate → Your flow → ... → Copy HTTP URL)
# -------------------------------------------------------------
POWER_AUTOMATE_FLOW_URL=<your-power-automate-http-trigger-url>
FIXED_RECRUITER_EMAIL=<recruiter-email@yourdomain.com>      # Email that receives interview notifications


# -------------------------------------------------------------
#  Vercel Blob  (DEPRECATED — all uploads (recordings, resumes, images) now
#  go to Azure Blob Storage. This token is no longer used by any code path and
#  can be removed once you've confirmed nothing external depends on it.)
# -------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=<your-vercel-blob-token>


# -------------------------------------------------------------
#  Azure Blob Storage — Voice Live interview recordings
#  (Azure Portal → Storage account → Access keys / Settings → Endpoints)
# -------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account-name>
AZURE_STORAGE_ACCOUNT_KEY=<your-storage-account-key>
AZURE_STORAGE_CONTAINER=interview-recordings                # Recordings container (must be lowercase)
# Resumes container — defaults to "interview-resumes". Same storage account as
# recordings; kept in a separate container. (Resumes migrated off Vercel Blob.)
# AZURE_STORAGE_RESUME_CONTAINER=interview-resumes
# User/candidate images container — defaults to "interview-images". Same
# account, separate container. (Images migrated off Vercel Blob.)
# AZURE_STORAGE_IMAGE_CONTAINER=interview-images
# Optional override — defaults to https://<account>.blob.core.windows.net
# AZURE_STORAGE_ENDPOINT=https://<your-account>.blob.core.windows.net


# -------------------------------------------------------------
#  Azure Voice Live API
#  Toggle USE_VOICE_LIVE=true to route real interviews through Voice Live
#  instead of Retell. Set false (or unset) to keep using Retell.
#  The /voice-test smoke page works regardless of this flag.
# -------------------------------------------------------------
USE_VOICE_LIVE=false                                        # Master switch — true to enable Voice Live
AZURE_VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
AZURE_VOICELIVE_API_KEY=<speech-or-foundry-key>
AZURE_VOICELIVE_MODEL=gpt-4o-mini-realtime-preview          # Or gpt-realtime-mini / gpt-5-mini
AZURE_VOICELIVE_VOICE=en-IN-Diya:DragonHDLatestNeural       # Any Azure Neural voice name
AZURE_VOICELIVE_API_VERSION=2025-10-01
# OPTIONAL. Reasoning depth, for reasoning-capable models ONLY (gpt-realtime
# 2.x, gpt-5.x). Higher effort = slower first audio, felt directly on a voice
# call. Models that don't support reasoning REJECT the session when this is
# set, so leave it unset unless you know the model accepts it.
# Allowed: none | minimal | low | medium | high | xhigh.
# AZURE_VOICELIVE_REASONING_EFFORT=low

# OPTIONAL. Audio playback jitter buffer, in milliseconds. Raise these if the
# agent's voice audibly cuts out mid-sentence on small network gaps. The cost is
# that much extra delay before the agent starts speaking, paid once per turn.
# MIN_LEAD is the one that matters for mid-sentence cuts — it sets how large an
# inter-chunk gap can be before playback runs dry. Defaults: 500 / 600.
# Note these cannot hide multi-second generation stalls; covering those would
# mean a multi-second pause before every reply.
# AZURE_VOICELIVE_PLAYBACK_LEAD_MS=500
# AZURE_VOICELIVE_PLAYBACK_MIN_LEAD_MS=1000

# OPTIONAL. Bring Your Own Model. Unset = AZURE_VOICELIVE_MODEL names one of
# Microsoft's fully-managed Voice Live models, running on their shared capacity
# (no Foundry metrics, no throughput control). Set = AZURE_VOICELIVE_MODEL is
# instead the name of a DEPLOYMENT in your own Foundry resource, so traffic runs
# on your deployment and its capacity/content-filter settings apply.
# Requires the Foundry resource's system-assigned managed identity to hold the
# "Foundry User" role — see how-to-bring-your-own-model in the Azure docs.
# Modes: byom-azure-openai-realtime | byom-azure-openai-chat-completion
#        | byom-foundry-anthropic-messages
# AZURE_VOICELIVE_BYOM_PROFILE=byom-azure-openai-realtime

# OPTIONAL. Only when the deployment lives in a different Foundry resource than
# the one serving Voice Live. Bare resource name, no domain suffix.
# AZURE_VOICELIVE_FOUNDRY_RESOURCE_OVERRIDE=my-other-foundry-resource


# -------------------------------------------------------------
#  Auth Security
#  IMPORTANT: Use strong random values in production.
#  Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -------------------------------------------------------------
PASSWORD_SALT=<random-32-char-string>   # Used to hash passwords — change from default!
JWT_SECRET=<random-64-char-string>      # Used to sign JWT tokens — change from default!

# Secret that gates the /api/voice-live/sweep-stale cron endpoint. Vercel Cron
# auto-injects `Authorization: Bearer $CRON_SECRET`. If unset, the sweeper
# refuses to run (fail closed). Required for the server-side interview-timeout
# watchdog to work.
CRON_SECRET=<random-64-char-string>
